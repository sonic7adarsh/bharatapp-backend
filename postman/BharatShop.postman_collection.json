              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"items\": [{\n      \"id\": \"prod_1\", \"name\": \"Product A\", \"price\": 299, \"currency\": \"INR\", \"category\": \"General\"\n    }],\n    \"page\": 0,\n    \"limit\": 25,\n    \"total\": 1\n  }\n}"
            }
