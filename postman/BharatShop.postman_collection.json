{
  "info": {
    "name": "BharatShop API Collection",
    "description": "Comprehensive Postman collection for BharatShop storefront, seller, platform, and legacy APIs. Uses variables: {{BASE}}, {{TENANT}}, {{TOKEN}}, {{GUEST_ID}}, {{STORE_ID}}, {{PRODUCT_ID}}, {{ORDER_ID}}, {{BOOKING_ID}}, {{ITEM_ID}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE", "value": "http://localhost:8081" },
    { "key": "TENANT", "value": "" },
    { "key": "TOKEN", "value": "" },
    { "key": "GUEST_ID", "value": "" },
    { "key": "STORE_ID", "value": "" },
    { "key": "PRODUCT_ID", "value": "" },
    { "key": "ORDER_ID", "value": "" },
    { "key": "ITEM_ID", "value": "" }
  ],
  "item": [
    {
      "name": "Storefront Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/register" },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Pass123!\"\n}" }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"user_123\",\n    \"name\": \"Alice\",\n    \"email\": \"alice@example.com\"\n  }\n}"
            },
            {
              "name": "400 Validation Error",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"Email already in use\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Login (email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/login/email" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Pass123!\"\n}" }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"token\": \"eyJhbGciOi...\",\n    \"user\": {\n      \"id\": \"user_123\",\n      \"name\": \"Alice\",\n      \"email\": \"alice@example.com\"\n    }\n  }\n}"
            },
            {
              "name": "401 Invalid Credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"INVALID_CREDENTIALS\",\n    \"message\": \"Invalid email or password\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Login (generic)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/login" },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Pass123!\"\n}" }
          }
        },
        {
          "name": "Login (phone + otp)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/login/phone" },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919999999999\",\n  \"otp\": \"123456\"\n}" }
          }
        },
        {
          "name": "OTP: Send",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/otp/send" },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919999999999\"\n}" }
          },
          "response": [
            {
              "name": "200 Sent",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": { \"otpId\": \"otp_123\" }\n}"
            }
          ]
        },
        {
          "name": "OTP: Verify",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/otp/verify" },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919999999999\",\n  \"otp\": \"123456\"\n}" }
          }
        },
        {
          "name": "OTP: Resend",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/otp/resend" },
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919999999999\",\n  \"otpId\": \"OTP123\"\n}" }
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/profile" }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"user_123\",\n    \"name\": \"Alice\",\n    \"email\": \"alice@example.com\",\n    \"roles\": [\"buyer\"]\n  }\n}"
            }
          ]
        },
        {
          "name": "Roles: Grant (planned)",
          "request": {
            "method": "POST",
            "description": "Note: Documented but not implemented in backend.",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "X-Tenant-Domain", "value": "{{TENANT}}" }
            ],
            "url": { "raw": "{{BASE}}/api/storefront/auth/roles/grant" },
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"seller\",\n  \"source\": \"seller_registration\"\n}" }
          }
        }
      ]
    },
